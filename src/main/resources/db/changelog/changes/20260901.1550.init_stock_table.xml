<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260901.1550.init_stock_table" author="stran">
        <createTable tableName="t_stock">
            <column name="stock_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="sku_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="location_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="quantity_on_hand" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="quantity_reserved" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260901.1550.add_pk" author="stran">
        <addPrimaryKey tableName="t_stock" columnNames="stock_id" constraintName="pk_stock" />
    </changeSet>

    <changeSet id="20260901.1550.add_fk" author="stran">
        <addForeignKeyConstraint baseTableName="t_stock" baseColumnNames="sku_id"
                                 constraintName="fk_stock_sku"
                                 referencedTableName="t_sku"
                                 referencedColumnNames="sku_id" onDelete="RESTRICT" />
        <addForeignKeyConstraint baseTableName="t_stock" baseColumnNames="location_id"
                                 constraintName="fk_stock_location"
                                 referencedTableName="t_location"
                                 referencedColumnNames="location_id" onDelete="RESTRICT" />
    </changeSet>

    <changeSet id="20260901.1550.add_uq_index" author="stran">
        <addUniqueConstraint tableName="t_stock" columnNames="sku_id, location_id"
                             constraintName="uq_stock_sku_location" />
    </changeSet>

    <changeSet id="20260901.1550.add_constraint" author="stran">
        <sql>ALTER TABLE t_stock ADD CONSTRAINT ck_stock_on_hand_non_negative CHECK (quantity_on_hand &gt;= 0)</sql>
        <sql>ALTER TABLE t_stock ADD CONSTRAINT ck_stock_reserved_non_negative CHECK (quantity_reserved &gt;= 0)</sql>
    </changeSet>
</databaseChangeLog>
