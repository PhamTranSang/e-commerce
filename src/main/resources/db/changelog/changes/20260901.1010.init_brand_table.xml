<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260901.1010.init_brand_table" author="stran">
        <createTable tableName="t_brand">
            <column name="brand_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="brand_name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260901.1015.add_pk" author="stran">
        <addPrimaryKey tableName="t_brand" columnNames="brand_id" constraintName="pk_brand" />
    </changeSet>

    <changeSet id="20260901.1015.add_uq_index" author="stran">
        <sql>
            CREATE UNIQUE INDEX uq_brand_name ON t_brand (LOWER(brand_name))
        </sql>
    </changeSet>

    <changeSet id="20260901.1015.add_constraint" author="stran">
        <sql>
            ALTER TABLE t_brand
            ADD CONSTRAINT ck_brand_name_normalized
            CHECK (brand_name = BTRIM(brand_name) AND brand_name &lt;&gt; '')
        </sql>
    </changeSet>
</databaseChangeLog>