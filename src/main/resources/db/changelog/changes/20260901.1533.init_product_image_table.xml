<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260901.1533.init_product_image_table" author="stran">
        <createTable tableName="t_product_image">
            <column name="image_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="product_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <!-- NULL = ảnh chung của product; có giá trị = ảnh gắn với một option value (vd màu Blue) -->
            <column name="option_value_id" type="UUID" />
            <column name="url" type="VARCHAR(1024)">
                <constraints nullable="false" />
            </column>
            <column name="alt_text" type="VARCHAR(255)" />
            <column name="position" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="is_primary" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260901.1533.product_image_add_pk" author="stran">
        <addPrimaryKey tableName="t_product_image" columnNames="image_id" constraintName="pk_product_image" />
    </changeSet>

    <changeSet id="20260901.1533.product_image_add_fk" author="stran">
        <addForeignKeyConstraint baseTableName="t_product_image" baseColumnNames="product_id"
                                 constraintName="fk_product_image_product"
                                 referencedTableName="t_product"
                                 referencedColumnNames="product_id" onDelete="RESTRICT" />
        <addForeignKeyConstraint baseTableName="t_product_image" baseColumnNames="option_value_id"
                                 constraintName="fk_product_image_option_value"
                                 referencedTableName="t_product_option_value"
                                 referencedColumnNames="option_value_id" onDelete="RESTRICT" />
    </changeSet>

    <changeSet id="20260901.1533.product_image_add_uq_index" author="stran">
        <!-- Mỗi product tối đa một ảnh chính -->
        <sql>
            CREATE UNIQUE INDEX uq_product_image_primary
            ON t_product_image (product_id)
            WHERE is_primary = TRUE
        </sql>
    </changeSet>
</databaseChangeLog>
