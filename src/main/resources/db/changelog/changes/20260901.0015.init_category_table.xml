<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260901.0015.init_category_table" author="stran">
        <createTable tableName="t_category">
            <column name="category_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="parent_id" type="UUID" />
            <column name="category_name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260901.0020.category_add_pk" author="stran">
        <addPrimaryKey tableName="t_category" columnNames="category_id" constraintName="pk_category" />
    </changeSet>

    <changeSet id="20260901.0025.category_add_fk" author="stran">
        <addForeignKeyConstraint baseTableName="t_category" baseColumnNames="parent_id"
                                 constraintName="fk_category_parent"
                                 referencedTableName="t_category"
                                 referencedColumnNames="category_id"
                                 onDelete="RESTRICT" onUpdate="RESTRICT" />
    </changeSet>

    <changeSet id="20260901.0030.category_add_uq_index" author="stran">
        <sql>
            CREATE UNIQUE INDEX uq_category_root_name
            ON t_category (LOWER(category_name))
            WHERE parent_id IS NULL
        </sql>
        <sql>
            CREATE UNIQUE INDEX uq_category_child_name
            ON t_category (parent_id, LOWER(category_name))
            WHERE parent_id IS NOT NULL
        </sql>
    </changeSet>

    <changeSet id="20260901.0035.category_add_constraints" author="stran">
        <sql>
            ALTER TABLE t_category
            ADD CONSTRAINT ck_category_name_normalized
            CHECK (category_name = BTRIM(category_name) AND category_name &lt;&gt; '')
        </sql>
    </changeSet>
</databaseChangeLog>
