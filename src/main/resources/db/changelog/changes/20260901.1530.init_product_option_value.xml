<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260901.1530.init_product_option_value_table" author="stran">
        <createTable tableName="t_product_option_value">
            <column name="option_value_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="option_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="value" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="position" type="INTEGER" defaultValue="0">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260901.1530.product_option_value_add_pk" author="stran">
        <addPrimaryKey tableName="t_product_option_value" columnNames="option_value_id"
                       constraintName="pk_product_option_value" />
    </changeSet>

    <changeSet id="20260901.1530.product_option_value_add_fk" author="stran">
        <addForeignKeyConstraint baseTableName="t_product_option_value" baseColumnNames="option_id"
                                 constraintName="fk_value_option"
                                 referencedTableName="t_product_option"
                                 referencedColumnNames="option_id"
                                 onDelete="RESTRICT" />
    </changeSet>

    <changeSet id="20260901.1530.product_option_value_add_uq_index" author="stran">
        <addUniqueConstraint tableName="t_product_option_value" columnNames="option_id, value"
                             constraintName="uq_value_per_option" />
    </changeSet>
</databaseChangeLog>