<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260815.1200.init_category_table" author="stran">
        <createTable tableName="t_category">
            <column name="category_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="category_name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="category_is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260815.1200.init_product_table" author="stran">
        <createTable tableName="t_product">
            <column name="product_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="category_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="product_name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="product_description" type="TEXT" />
            <column name="product_is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260815.1200.init_sku_table" author="stran">
        <createTable tableName="t_sku">
            <column name="sku_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="product_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="sku_code" type="VARCHAR(64)">
                <constraints nullable="false" />
            </column>
            <column name="sku_is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="weight_grams" type="INTEGER">
                <constraints nullable="false" />
            </column>
            <column name="amount" type="NUMERIC(12, 2)">
                <constraints nullable="false" />
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
