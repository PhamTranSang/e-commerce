<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260901.1525.init_product_option_table" author="stran">
        <createTable tableName="t_product_option">
            <column name="option_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="product_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="option_name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="position" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260901.1525.product_option_add_pk" author="stran">
        <addPrimaryKey tableName="t_product_option" columnNames="option_id" constraintName="pk_product_option" />
    </changeSet>

    <changeSet id="20260901.1525.product_option_add_fk" author="stran">
        <addForeignKeyConstraint baseTableName="t_product_option" baseColumnNames="product_id"
                                 constraintName="fk_option_product"
                                 referencedTableName="t_product"
                                 referencedColumnNames="product_id" />
    </changeSet>

    <changeSet id="20260901.1525.product_option_add_uq_index" author="stran">
        <addUniqueConstraint tableName="t_product_option" columnNames="product_id, option_name"
                             constraintName="uq_option_name_per_product" />
    </changeSet>
</databaseChangeLog>