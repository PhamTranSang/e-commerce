<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260901.1605.init_password_credential_table" author="stran">
        <createTable tableName="t_password_credential">
            <column name="credential_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="account_id" type="UUID">
                <constraints nullable="false" />
            </column>
            <column name="login" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260901.1605.add_pk" author="stran">
        <addPrimaryKey tableName="t_password_credential" columnNames="credential_id"
                       constraintName="pk_password_credential" />
    </changeSet>

    <changeSet id="20260901.1605.add_fk" author="stran">
        <addForeignKeyConstraint baseTableName="t_password_credential" baseColumnNames="account_id"
                                 constraintName="fk_password_credential_account"
                                 referencedTableName="t_account"
                                 referencedColumnNames="account_id" onDelete="RESTRICT" />
    </changeSet>

    <changeSet id="20260901.1605.add_uq_index" author="stran">
        <!-- 1 account có tối đa 1 mật khẩu -->
        <addUniqueConstraint tableName="t_password_credential" columnNames="account_id"
                             constraintName="uq_password_credential_account" />
        <!-- login (email/username) duy nhất toàn hệ -->
        <addUniqueConstraint tableName="t_password_credential" columnNames="login"
                             constraintName="uq_password_credential_login" />
    </changeSet>
</databaseChangeLog>
