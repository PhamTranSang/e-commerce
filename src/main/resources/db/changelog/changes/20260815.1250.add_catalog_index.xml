<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260815.1250.add_product_index" author="stran">
        <createIndex tableName="t_product" indexName="idx_product_list">
            <column name="category_id" />
            <column name="product_is_active" />
            <column name="created_at" />
            <column name="product_id" />
        </createIndex>
    </changeSet>

    <changeSet id="20260815.1250.add_sku_index" author="stran">
        <createIndex tableName="t_sku" indexName="idx_sku_product">
            <column name="product_id" />
            <column name="sku_is_active" />
        </createIndex>
    </changeSet>
</databaseChangeLog>